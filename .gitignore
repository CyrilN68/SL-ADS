.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# Editors / IDE
.idea/
.vscode/
.obsidian/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/
.codex_manual_tmp/
.pytest*/
_pytest*/
pytest-cache-files-*/
.testtmp/
.tmp_pytest_safe/
